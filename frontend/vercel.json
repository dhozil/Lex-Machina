{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/rpc/studionet/:path*",
      "destination": "https://studio.genlayer.com/api/:path*"
    },
    {
      "source": "/rpc/studio_next/:path*",
      "destination": "https://studio-dev.genlayer.com/api/:path*"
    },
    {
      "source": "/rpc/testnet_asimov/:path*",
      "destination": "https://rpc-asimov.genlayer.com/:path*"
    },
    {
      "source": "/rpc/testnet_bradbury/:path*",
      "destination": "https://rpc-bradbury.genlayer.com/:path*"
    }
  ]
}
